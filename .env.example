OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AI_PROVIDER can be openai or gemini. If omitted, Gemini is used when GEMINI_API_KEY exists.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If set, call API routes with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional RSS feed config.
# JSON array is recommended:
# NEWS_RSS_FEEDS=[{"name":"교육부 보도자료","url":"https://example.com/rss.xml","category":"교육정책"}]
# Or comma-separated feed URLs:
# NEWS_RSS_FEEDS=https://example.com/rss.xml,https://example.org/feed.xml
NEWS_RSS_FEEDS=
